---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE } from '../../consts';
import { inline } from '../../utils/inline';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((s) => ({ params: { slug: s.id }, props: { story: s } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const d = story.data;

const all = await getCollection('stories');
const explicit = all.filter(
  (s) => s.id !== story.id && (d.related.includes(s.id) || s.data.related.includes(story.id))
);
const byTag = all.filter(
  (s) =>
    s.id !== story.id &&
    !explicit.some((e) => e.id === s.id) &&
    s.data.tags.some((t) => d.tags.includes(t))
);
const related = [...explicit, ...byTag].slice(0, 3);

const entries = await getCollection('worldview');
const linkedEntries = entries.filter((e) => e.data.related.includes(story.id)).slice(0, 6);

const desc = d.excerpt;

const site = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/$/, '');
const pageUrl = `${site}/stories/${story.id}/`;
const abs = (u) => new URL(u, `${site}/`).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    alternateName: d.titleZh,
    description: d.excerpt,
    image: d.image ? [abs(d.image)] : undefined,
    datePublished: d.published,
    dateModified: d.published,
    inLanguage: 'en',
    keywords: d.tags.join(', '),
    author: { '@type': 'Organization', name: SITE.name, url: site },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: site },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    about: { '@type': 'Thing', name: d.sourceZh },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Stories', item: `${site}/stories/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={d.title} description={desc} ogImage={d.image ?? '/images/og-default.jpg'} jsonLd={jsonLd}>
  <div class="wrap-narrow">
    <header class="article-head">
      <p class="crumbs">
        <a href="/stories">Stories</a><span class="breadcrumb-sep">/</span>
        <a href={`/stories?source=${encodeURIComponent(d.sourceZh)}`}>{d.sourceZh}</a><span class="breadcrumb-sep">/</span>
        <span>{d.title}</span>
      </p>
      <h1>{d.title}</h1>
      <p class="title-zh">{d.titleZh}</p>

      <div class="factbar">
        <div class="fact"><b>Source</b>{d.source}</div>
        <div class="fact"><b>Author</b>{d.author}</div>
        <div class="fact"><b>Era</b>{d.era}</div>
        {d.compiled && <div class="fact"><b>Written</b>{d.compiled}</div>}
      </div>

      <div style="margin-top:16px; display:flex; flex-wrap:wrap; gap:7px;">
        {d.tags.map((t) => <span class="pill pill-accent">{t}</span>)}
      </div>
    </header>

    <div style="padding:36px 0 8px;">
      {
        d.image && (
          <figure class="figure">
            <img src={d.image} alt={d.imageAlt} width="1400" height="933" />
            <figcaption>Illustration generated by AI, based on the ancient Chinese text.</figcaption>
          </figure>
        )
      }

      <article class="prose">
        <Content />
      </article>

      {
        d.original && (
          <details class="fold">
            <summary>Original classical Chinese text · 原文</summary>
            <div class="fold-body">
              <p class="han">{d.original}</p>
              {d.originalNote && <p class="han-note" set:html={inline(d.originalNote)} />}
            </div>
          </details>
        )
      }

      {
        d.notes.length > 0 && (
          <aside class="notes-box">
            <h3>Cultural Notes · 文化注解</h3>
            <dl>
              {d.notes.map((n) => (
                <>
                  <dt>{n.term}</dt>
                  <dd set:html={inline(n.text)} />
                </>
              ))}
            </dl>
          </aside>
        )
      }

      <div class="source-note">
        <b>Source.</b> From <i>{d.source}</i> ({d.sourceZh}), by {d.author}
        {d.compiled && <>, {d.compiled}</>}. The original text is in the public domain; this English
        rendering and the accompanying notes are original work.
      </div>

      {
        linkedEntries.length > 0 && (
          <div class="entry-links">
            <b>Where this fits in the universe:</b>{' '}
            {linkedEntries.map((e, i) => (
              <>
                {i > 0 && ' · '}
                <a href={`/worldview/${e.id}`}>{e.data.title}</a>
              </>
            ))}
          </div>
        )
      }
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">Keep Reading</p>
              <h2>Related Stories</h2>
            </div>
          </div>
          <div class="grid grid-3">
            {related.map((s) => (
              <StoryCard
                href={`/stories/${s.id}`}
                title={s.data.title}
                titleZh={s.data.titleZh}
                excerpt={s.data.excerpt}
                meta={`${s.data.era} · ${s.data.sourceZh}`}
                tags={s.data.tags}
                image={s.data.image}
                imageAlt={s.data.imageAlt}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Newsletter />
</BaseLayout>
