---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const features = await getCollection('features');
  return features.map((f) => ({ params: { slug: f.id }, props: { feature: f } }));
}

const { feature } = Astro.props;
const { Content } = await render(feature);
const d = feature.data;

const stories = await getCollection('stories');
const linked = stories.filter((s) => d.related.includes(s.id)).slice(0, 3);

const site = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/$/, '');
const pageUrl = `${site}/features/${feature.id}/`;
const abs = (u) => new URL(u, `${site}/`).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.excerpt,
    image: d.image ? [abs(d.image)] : undefined,
    datePublished: d.published,
    dateModified: d.published,
    inLanguage: 'en',
    author: { '@type': 'Organization', name: SITE.name, url: site },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: site },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Features', item: `${site}/features/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={d.title} description={d.excerpt} ogImage={d.image ?? '/images/og-default.jpg'} jsonLd={jsonLd}>
  <div class="wrap-narrow">
    <header class="article-head">
      <p class="crumbs">
        <a href="/features">Features</a><span class="breadcrumb-sep">/</span><span>{d.title}</span>
      </p>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="lede" style="font-style:italic; margin-bottom:0;">{d.subtitle}</p>}
    </header>

    <div style="padding:36px 0 8px;">
      {
        d.image && (
          <figure class="figure">
            <img src={d.image} alt={d.imageAlt} width="1400" height="933" />
            <figcaption>Illustration generated by AI, based on ancient Chinese sources.</figcaption>
          </figure>
        )
      }

      <article class="prose">
        <Content />
      </article>
    </div>
  </div>

  {
    linked.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">From the Library</p>
              <h2>Stories in This Essay</h2>
            </div>
          </div>
          <div class="grid grid-3">
            {linked.map((s) => (
              <StoryCard
                href={`/stories/${s.id}`}
                title={s.data.title}
                titleZh={s.data.titleZh}
                excerpt={s.data.excerpt}
                meta={`${s.data.era} · ${s.data.sourceZh}`}
                tags={s.data.tags}
                image={s.data.image}
                imageAlt={s.data.imageAlt}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Newsletter />
</BaseLayout>
