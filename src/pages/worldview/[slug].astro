---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { BRANCHES, SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('worldview');
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = await getCollection('worldview');
const siblings = all.filter((e) => e.data.branch === d.branch && e.id !== entry.id).slice(0, 3);

const stories = await getCollection('stories');
const linkedStories = stories.filter((s) => d.related.includes(s.id)).slice(0, 3);
const linkedEntries = all.filter((e) => e.id !== entry.id && d.related.includes(e.id)).slice(0, 4);
const branch = BRANCHES[d.branch as keyof typeof BRANCHES];

const site = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/$/, '');
const pageUrl = `${site}/worldview/${entry.id}/`;
const abs = (u) => new URL(u, `${site}/`).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    alternateName: d.titleZh,
    description: d.summary,
    image: d.image ? [abs(d.image)] : undefined,
    inLanguage: 'en',
    author: { '@type': 'Organization', name: SITE.name, url: site },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: site },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Worldview', item: `${site}/worldview/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={d.title} description={d.summary} ogImage={d.image ?? '/images/og-default.jpg'} jsonLd={jsonLd}>
  <div class="wrap-narrow">
    <header class="article-head">
      <p class="crumbs">
        <a href="/worldview">Worldview</a><span class="breadcrumb-sep">/</span>
        <a href={`/worldview#${d.branch}`}>{branch?.label}</a><span class="breadcrumb-sep">/</span>
        <span>{d.title}</span>
      </p>
      <h1>{d.title}</h1>
      <p class="title-zh">{d.titleZh}</p>
    </header>

    <div style="padding:36px 0 8px;">
      {
        d.image && (
          <figure class="figure">
            <img src={d.image} alt={d.imageAlt} width="1400" height="933" />
            <figcaption>Illustration generated by AI, based on ancient Chinese sources.</figcaption>
          </figure>
        )
      }

      <article class="prose">
        <Content />
      </article>

      {
        siblings.length > 0 && (
          <div class="source-note">
            <b>More in {branch?.label}:</b>{' '}
            {siblings.map((s, i) => (
              <>
                {i > 0 && ' · '}
                <a href={`/worldview/${s.id}`}>{s.data.title}</a>
              </>
            ))}
          </div>
        )
      }
    </div>
  </div>

  {
    linkedEntries.length > 0 && (
      <div class="wrap">
        <div class="source-note">
          <b>Related entries:</b>{' '}
          {linkedEntries.map((e, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/worldview/${e.id}`}>{e.data.title}</a>
            </>
          ))}
        </div>
      </div>
    )
  }

  {
    linkedStories.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">In the Library</p>
              <h2>Related Stories</h2>
            </div>
          </div>
          <div class="grid grid-3">
            {linkedStories.map((s) => (
              <StoryCard
                href={`/stories/${s.id}`}
                title={s.data.title}
                titleZh={s.data.titleZh}
                excerpt={s.data.excerpt}
                meta={`${s.data.era} · ${s.data.sourceZh}`}
                tags={s.data.tags}
                image={s.data.image}
                imageAlt={s.data.imageAlt}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
