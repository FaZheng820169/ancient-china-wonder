---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Reading Guides" description="New to Chinese mythology and zhiguai literature? Start here: what zhiguai is, the map of the universe, the key concepts, and how we translate.">
  <section class="section">
    <div class="wrap-narrow">
      <p class="kicker">Guides · 指南</p>
      <h1>Reading Guides</h1>
      <p class="lede" style="max-width:60ch;">
        Everything a new reader needs: what this genre is, how its universe is built, the vocabulary it
        runs on, and how we bring it into English.
      </p>

      <div class="grid grid-2" style="margin-top:40px;">
        {
          guides.map((g) => (
            <article class="card story-card">
              <div class="body">
                <div class="meta">Guide {String(g.data.order).padStart(2, '0')}</div>
                <h3><a href={`/guides/${g.id}`}>{g.data.title}</a></h3>
                <p class="excerpt">{g.data.excerpt}</p>
                <div class="card-foot"><a class="pill pill-accent" href={`/guides/${g.id}`}>Read &rarr;</a></div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
