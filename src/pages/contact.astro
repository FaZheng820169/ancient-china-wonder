---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Corrections, questions and suggestions for Ancient China Wonder.">
  <section class="section">
    <div class="wrap-narrow">
      <p class="kicker">Contact</p>
      <h1>Write to the Library</h1>
      <div class="prose" style="margin-top:28px;">
        <p>
          The most valuable mail this site can receive is a <strong>correction</strong>: a mistranslated
          line, a wrong date, a misattributed tale, a broken link. If you have one, it will be checked
          against the original text and, if confirmed, fixed — with thanks.
        </p>
        <p>
          Also welcome: suggestions for the next story to translate, questions about the tradition, and
          notes from scholars, storytellers and TTRPG designers who want to build on this material.
        </p>
        <p>
          Write to: <strong>hello [at] ancientchinawonder [dot] com</strong>
        </p>
        <p class="small muted">
          Please allow a few days for a reply — this is a one-reader project, maintained between the
          translating and the woodcutting.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
