---
import BrandMark from './BrandMark.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/stories', label: 'Stories' },
  { href: '/worldview', label: 'Worldview' },
  { href: '/features', label: 'Features' },
  { href: '/guides', label: 'Guides' },
  { href: '/books', label: 'Books' },
  { href: '/start-here', label: 'Start Here' },
  { href: '/about', label: 'About' },
];

function isActive(href: string) {
  return path === href || path.startsWith(href + '/');
}
---

<header class="site-header" data-pagefind-ignore>
  <div class="wrap">
    <a class="brand" href="/" aria-label="Ancient China Wonder, home">
      <BrandMark size={30} />
      <span class="brand-text">
        <span class="brand-name">Ancient China Wonder</span>
        <span class="brand-sub">Gods · Ghosts · Fox Spirits</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>

    <nav class="nav" id="main-nav" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href="/search" aria-label="Search">&#9906;</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
