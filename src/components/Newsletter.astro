---
---

<section class="section-tight">
  <div class="wrap">
    <div class="newsletter">
      <p class="kicker">Correspondence</p>
      <h2>One strange tale, every week</h2>
      <p>
        A single translated story delivered by email each week — no spam, no tracking pixels, unsubscribe
        in one click.
      </p>
      <form action="https://buttondown.email/api/emails/embed-subscribe/ancientchinawonder" method="post" target="_blank">
        <label class="skip" for="nl-email">Email address</label>
        <input
          id="nl-email"
          type="email"
          name="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
        />
        <button class="btn btn-primary" type="submit">Subscribe</button>
      </form>
      <p class="fine">
        We store your email address only to send the newsletter. See the
        <a href="/privacy">privacy policy</a>.
      </p>
    </div>
  </div>
</section>
