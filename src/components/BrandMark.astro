---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<!-- A seal-like mark: mountain (shan) above water, drawn as an ink brush glyph -->
<svg
  class="brand-mark"
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect x="0.75" y="0.75" width="38.5" height="38.5" rx="2.5" stroke="#A62C21" stroke-width="1.5" />
  <path d="M20 8.5 L27.5 22 L12.5 22 Z" fill="#A62C21" opacity="0.9" />
  <path d="M20 15.5 L25 24 L15 24 Z" fill="#2D5016" opacity="0.75" />
  <path d="M9 27.5 Q14 25.5 19 27.5 T29 27.5" stroke="#A62C21" stroke-width="1.6" fill="none" stroke-linecap="round" />
  <path d="M9 31.5 Q14 29.5 19 31.5 T29 31.5" stroke="#2D5016" stroke-width="1.3" fill="none" stroke-linecap="round" opacity="0.7" />
</svg>
